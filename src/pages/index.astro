---
import Layout from '../layouts/Layout.astro';
import VueTest from '../components/VueTest.vue';
import SvelteTest from '../components/SvelteTest.svelte';
---

<Layout>
	<section class="mx-auto max-w-6xl px-6 py-12">
		<div class="max-w-2xl">
			<p class="text-sm font-medium uppercase tracking-widest text-mx-green">
				Mundial 2026
			</p>
			<h1 class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Monitoreo de criptomonedas en tiempo real
			</h1>
			<p class="mt-4 text-base leading-relaxed text-slate-400">
				Base estática generada por Astro. Las islas Vue y Svelte se activan en el
				cliente para filtros y datos en vivo.
			</p>
		</div>

		<div class="mt-10 grid w-full max-w-lg gap-3 sm:grid-cols-2">
			<VueTest client:load message="Isla Vue renderizada" />
			<SvelteTest client:load message="Isla Svelte renderizada" />
		</div>
	</section>
</Layout>
