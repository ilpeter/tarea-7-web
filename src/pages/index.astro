---
import Layout from '../layouts/Layout.astro';
import CryptoList from '../components/CryptoList.astro';
---

<Layout>
	<section class="mx-auto max-w-6xl px-6 py-12">
		<div class="max-w-2xl">
			<p class="text-sm font-medium uppercase tracking-widest text-mx-green">
				Mundial 2026
			</p>
			<h1 class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-5xl">
				Monitoreo de criptomonedas en tiempo real
			</h1>
			<p class="mt-4 text-base leading-relaxed text-slate-400">
				El océano estático de Astro pre-renderiza la lista de mercados al compilar.
				Las islas Vue y Svelte llegarán después para filtros y datos en vivo.
			</p>
		</div>

		<div class="mt-10">
			<CryptoList />
		</div>
	</section>
</Layout>
