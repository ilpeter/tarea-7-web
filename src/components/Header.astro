---
const navLinks = [
	{ label: "Dashboard", href: "/" },
	{ label: "Mercados", href: "#" },
	{ label: "Noticias", href: "#" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/95 backdrop-blur-sm">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
		<a href="/" class="group flex items-center gap-3">
			<span
				class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-raised ring-1 ring-border"
				aria-hidden="true"
			>
				<svg
					class="h-5 w-5 text-mx-green"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						d="M3 17l6-6 4 4 8-8M3 21h18"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
			<div>
				<p class="text-lg font-bold leading-tight tracking-tight text-white">
					Crypto Dashboard
				</p>
				<p class="text-xs font-medium text-slate-400">
					Mundial 2026 · MX · US · CA
				</p>
			</div>
		</a>

		<nav aria-label="Principal">
			<ul class="flex items-center gap-1 sm:gap-2">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="rounded-md px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-surface-raised hover:text-white"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<div class="flex h-1 w-full" aria-hidden="true">
		<span class="flex-1 bg-mx-green"></span>
		<span class="flex-1 bg-us-blue"></span>
		<span class="flex-1 bg-ca-red"></span>
	</div>
</header>
