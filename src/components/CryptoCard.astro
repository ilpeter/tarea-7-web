---
interface Props {
	name: string;
	symbol: string;
	image: string;
	rank?: number;
}

const { name, symbol, image, rank } = Astro.props;
---

<li class="group">
	<article
		class="flex h-full flex-col items-center rounded-xl border border-border bg-surface-raised px-4 py-6 text-center transition-colors group-hover:border-mx-green/40 group-hover:bg-surface-raised/80 sm:px-5 sm:py-7"
	>
		{
			rank !== undefined && (
				<p class="mb-3 text-xs font-semibold tabular-nums text-slate-500">#{rank}</p>
			)
		}

		<img
			src={image}
			alt={`Logo de ${name}`}
			width={56}
			height={56}
			class="h-14 w-14 rounded-full bg-surface object-cover ring-2 ring-border sm:h-16 sm:w-16"
			loading="lazy"
			decoding="async"
		/>

		<h3 class="mt-4 line-clamp-2 text-base font-semibold leading-snug text-white sm:text-lg">
			{name}
		</h3>

		<p class="mt-1 text-sm font-medium uppercase tracking-widest text-slate-400">
			{symbol}
		</p>
	</article>
</li>
